<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portfolio_page_template" name="Portfolio Page">
        <t t-call="website.layout">
            <div id="wrap" class="portfolio-page">

                <!-- Hero section -->
                <section class="portfolio-hero">
                    <div class="container text-center py-5">
                        <h1 t-esc="name"/>
                        <p class="lead" t-esc="tagline"/>
                        <a t-att-href="github_url" target="_blank"
                           class="btn btn-primary btn-lg mt-3">
                            View code on GitHub
                        </a>
                    </div>
                </section>

                <!-- Skills section -->
                <section class="portfolio-skills py-4">
                    <div class="container text-center">
                        <span t-foreach="skills" t-as="skill"
                              class="badge portfolio-badge"
                              t-esc="skill"/>
                    </div>
                </section>

                <!-- Project showcase -->
                <section class="portfolio-project py-5">
                    <div class="container">
                        <h2 class="text-center mb-4">Project: Library</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <h4>What it is</h4>
                                <p>
                                    A training Odoo module for managing a library:
                                    tracking books, members, and loan history.
                                    Built from scratch to learn the Odoo framework
                                    before applying for a Back-end Developer position.
                                </p>
                            </div>
                            <div class="col-md-6">
                                <h4>What's inside</h4>
                                <ul>
                                    <li>Three related models: book / member / loan</li>
                                    <li>Computed fields (book availability)</li>
                                    <li>Access rights via ir.model.access.csv</li>
                                    <li>Custom views: form, list, search</li>
                                    <li>Constraint validation (can't lend an already-borrowed book)</li>
                                </ul>
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <em>Interface screenshots — add here once
                                library is populated with demo data.</em>
                        </div>
                    </div>
                </section>

                <!-- Contact / footer -->
                <section class="portfolio-contact py-5 text-center">
                    <div class="container">
                        <h3>Contact</h3>
                        <p>Email: your-email@example.com</p>
                        <a t-att-href="github_url" target="_blank">GitHub</a>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
